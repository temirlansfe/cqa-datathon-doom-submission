# Organizer dataset API. Either a URL containing {group_id}, or a base URL (?group_id=... is appended).
DATASET_API_URL=

# LLM: gemini | mock  (without GEMINI_API_KEY the app falls back to mock heuristics)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# -1 = model default thinking; 0 disables thinking (cheaper/faster), e.g. 2048 caps it
GEMINI_THINKING_BUDGET=-1

# Cost estimate, USD per 1M tokens (gemini-2.5-flash list price)
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

BATCH_CONCURRENCY=6

# Host ports (bound to 127.0.0.1)
APP_PORT=8090
DB_PORT=5442
POSTGRES_PASSWORD=cqa
